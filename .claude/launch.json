{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "epivascan-site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "epivascan-space",
      "runtimeExecutable": "ml/.venv-space/Scripts/python.exe",

    {
      "name": "epivascan-app-web",
      "runtimeExecutable": ".tools/node22/node-v22.23.4-win-x64/node.exe",
      "runtimeArgs": [
        "app/scripts/dev-web.js"
      ],
      "port": 8081
    }
  ]
}